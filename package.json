{
  "name": "s2j-slug-generater",
  "version": "1.0.0",
  "description": "WordPress plugin for generating slugs using translation APIs",
  "author": "stein2nd",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "keywords": [
    "wordpress",
    "plugin",
    "slug",
    "translation",
    "gutenberg"
  ],
  "main": "s2j-slug-generater.php",
  "scripts": {
    "build:dev": "FLUSH_DIST=true npm run build:dev:admin && npm run build:dev:gutenberg && npm run build:dev:classic",
    "build:dev:admin": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
    "build:dev:gutenberg": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
    "build:dev:classic": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
    "build:production": "FLUSH_DIST=true npm run build:production:admin && npm run build:production:gutenberg && npm run build:production:classic",
    "build:production:admin": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
    "build:production:gutenberg": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
    "build:production:classic": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
    "dev": "vite build --watch --mode development",
    "type-check": "tsc --noEmit",
    "lint:ts": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx",
    "lint:ts:fix": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx --fix",
    "lint:scss": "stylelint src/**/*.scss",
    "lint:scss:fix": "stylelint src/**/*.scss --fix",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
    "makepot": "wp i18n make-pot . languages/s2j-slug-generater.pot --domain=s2j-slug-generater"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.33",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/wordpress__blocks": "^12.5.18",
    "@types/wordpress__wordcount": "^2.4.5",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@wordpress/block-editor": "^15.9.0",
    "@wordpress/blocks": "^15.9.0",
    "@wordpress/components": "^30.9.0",
    "@wordpress/core-data": "^7.36.0",
    "@wordpress/data": "^10.36.0",
    "@wordpress/editor": "^14.36.0",
    "@wordpress/element": "^6.36.0",
    "@wordpress/hooks": "^4.36.0",
    "@wordpress/i18n": "^6.9.0",
    "@wordpress/url": "^4.36.0",
    "@wordpress/wordcount": "^4.36.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "sass": "^1.94.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
