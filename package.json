{
    "name": "s2j-slug-generater",
    "version": "2.0.20",
    "description": "WordPress plugin for generating slugs using translation APIs",
    "type": "module",
    "author": "Koutarou ISHIKAWA",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stein2nd/s2j-slug-generater.git"
    },
    "homepage": "https://github.com/stein2nd/s2j-slug-generater#readme",
    "bugs": {
        "url": "https://github.com/stein2nd/s2j-slug-generater/issues"
    },
    "keywords": [
        "wordpress",
        "plugin",
        "slug",
        "translation",
        "gutenberg"
    ],
    "main": "s2j-slug-generater.php",
    "scripts": {
        "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
        "lint": "npm run lint:ts && npm run lint:scss",
        "lint:fix": "npm run lint:ts:fix && npm run lint:scss:fix",
        "lint:ts": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx",
        "lint:ts:fix": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx --fix",
        "lint:scss": "stylelint src/**/*.scss",
        "lint:scss:fix": "stylelint src/**/*.scss --fix",
        "lint:php": "composer lint:php",
        "phpstan": "composer phpstan",
        "phpcs": "composer phpcs",
        "phpcs:wpcs": "composer phpcs:wpcs",
        "build:dev": "FLUSH_DIST=true npm run build:dev:admin && npm run build:dev:gutenberg && npm run build:dev:classic",
        "build:dev:admin": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
        "build:dev:gutenberg": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
        "build:dev:classic": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode development",
        "build:production": "FLUSH_DIST=true npm run build:production:admin && npm run build:production:gutenberg && npm run build:production:classic",
        "build:production:admin": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
        "build:production:gutenberg": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
        "build:production:classic": "FLUSH_DIST=false VITE_LOG_LEVEL=error vite build --mode production",
        "type-check": "tsc --noEmit",
        "dev": "vite build --mode development --watch",
        "makepot": "wp i18n make-pot . languages/s2j-slug-generater.pot --domain=s2j-slug-generater",
        "makejson": "wp i18n make-json languages/s2j-slug-generater-ja.po --no-purge && node scripts/copy-gutenberg-jed.mjs",
        "pretest:unit:php:local": "composer install --no-interaction --prefer-dist",
        "test:unit:php:local": "composer test",
        "pretest:lint:php": "composer install --no-interaction --prefer-dist",
        "dist:build": "composer install --no-dev --optimize-autoloader --no-interaction && npm run build:production",
        "dist:zip": "node tools/dist/make-dist-zip.mjs",
        "dist": "npm run dist:build && npm run dist:zip",
        "wp-env": "wp-env",
        "phpunit:wp-env": "wp-env start && wp-env run tests-cli --env-cwd=wp-content/plugins/s2j-slug-generater vendor/bin/phpunit -c phpunit.xml.dist --testdox",
        "version:sync": "node scripts/sync-version.mjs",
        "version:check": "node scripts/sync-version.mjs --check",
        "postversion": "npm run version:sync && git add s2j-slug-generater.php src/gutenberg/block.json"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@s2j/docs-linter": "^1.0.29",
        "@types/jquery": "^4.0.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@wordpress/api-fetch": "^7.57.0",
        "@wordpress/block-editor": "^18.1.0",
        "@wordpress/blocks": "^16.2.0",
        "@wordpress/components": "^42.0.0",
        "@wordpress/core-data": "^8.2.0",
        "@wordpress/data": "^10.57.0",
        "@wordpress/edit-post": "^8.57.0",
        "@wordpress/editor": "^15.2.0",
        "@wordpress/element": "^9.0.0",
        "@wordpress/env": "^11.17.0",
        "@wordpress/hooks": "^4.57.0",
        "@wordpress/i18n": "^6.30.0",
        "@wordpress/plugins": "^7.57.0",
        "@wordpress/url": "^4.57.0",
        "@wordpress/wordcount": "^4.57.0",
        "eslint": "^10.12.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "patch-package": "^8.0.1",
        "sass": "^1.105.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.4"
    },
    "allowScripts": {
        "@s2j/docs-linter": true,
        "@wordpress/env": true
    }
}
