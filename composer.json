{
	"name": "s2j/s2j-slug-generater",
	"description": "WordPress plugin for generating slugs using translation APIs",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=8.3",
		"s2j/similarity-service": "^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"phpstan/phpstan": "^2.1",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"php-stubs/wordpress-stubs": "^6.8"
	},
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test:unit": "@php vendor/bin/phpunit -c phpunit.unit.xml.dist",
		"test:integration": "@php vendor/bin/phpunit -c phpunit.xml.dist",
		"test:all": [
			"@test:unit",
			"@test:integration"
		],
		"test": "@test:all",
		"phpstan": "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=512M",
		"phpcs": "@php vendor/bin/phpcs -p",
		"phpcs:wpcs": "@php vendor/bin/phpcs -p --standard=phpcs.wpcs.xml.dist",
		"phpcbf": "@php vendor/bin/phpcbf",
		"lint:php": [
			"@phpstan",
			"@phpcs",
			"@phpcs:wpcs"
		]
	}
}
