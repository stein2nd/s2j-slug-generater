msgid "Similarity Settings"
msgstr "類似度の設定"

#: includes/Admin/SettingsPage.php:135
msgid "Similarity AI Service"
msgstr "類似度 AI サービス"

#: includes/Admin/SettingsPage.php:142
msgid "Similarity AI API Key"
msgstr "類似度 AI API キー"

#: includes/Admin/SettingsPage.php:149
msgid "Similarity AI Model"
msgstr "類似度 AI モデル"

#: includes/Admin/SettingsPage.php:156
